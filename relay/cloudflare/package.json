{
  "name": "contour-relay",
  "version": "1.0.0",
  "private": true,
  "description": "Relay for contour-deck remotes: a Cloudflare Worker and one Durable Object per room (docs/PROTOCOL.md).",
  "license": "MPL-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "dev": "wrangler dev --port 8787 --var \"ALLOWED_ORIGINS:http://localhost:*,http://127.0.0.1:*\"",
    "deploy": "wrangler deploy",
    "smoke": "node scripts/smoke.mjs"
  },
  "packageManager": "pnpm@12.9.1",
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.7.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.160.0",
    "ws": "^8.22.2"
  }
}
